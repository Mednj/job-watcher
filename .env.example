# Copy to .env. Never commit .env or your Telegram token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional bearer token for API access, required when exposed beyond localhost.
APP_ACCESS_TOKEN=
# Exact browser-visible origin when deployed behind an HTTPS reverse proxy, e.g.
# https://job-watcher.example.com (scheme + host + optional port; no path).
APP_PUBLIC_ORIGIN=
JOB_WATCHER_DB=data/jobs.sqlite3
# Global spacing between requests to the same source, across all saved searches.
SOURCE_REQUEST_GAP_SECONDS=15
HTTP_TIMEOUT_SECONDS=20

# Optional: dedicated JobTeaser browser opened manually before attachment.
JOBTEASER_CDP_ENDPOINT=

# JobTeaser checks up to 5 pages (maximum 20); pauses at least 2 seconds between pages.
JOBTEASER_MAX_PAGES=5
JOBTEASER_PAGE_DELAY_SECONDS=2
