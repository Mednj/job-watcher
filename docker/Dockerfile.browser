FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium xvfb x11vnc novnc websockify fluxbox ca-certificates curl tini && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 browser && mkdir /profile && chown browser:browser /profile
COPY docker/browser-start.sh /usr/local/bin/browser-start
RUN chmod +x /usr/local/bin/browser-start
USER browser
ENV DISPLAY=:99
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-start"]
